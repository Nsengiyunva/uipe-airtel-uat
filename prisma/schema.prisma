generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Everything Airtel POSTs to the callback URL, stored as received.
model AirtelCallback {
  id            BigInt   @id @default(autoincrement())
  receivedAt    DateTime @default(now()) @map("received_at") @db.Timestamptz
  sourceIp      String?  @map("source_ip")
  contentType   String?  @map("content_type")
  headers       Json?
  /// Exact request body text, whatever it was (JSON or not).
  rawBody       String   @map("raw_body")
  /// rawBody parsed as JSON; null when it was not valid JSON.
  body          Json?
  /// Convenience columns pulled out of body.transaction when present.
  reference     String?
  statusCode    String?  @map("status_code")
  airtelMoneyId String?  @map("airtel_money_id")

  @@index([reference])
  @@map("airtel_callbacks")
}
